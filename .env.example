# ============================================================
# Professional Trading Bot — Environment Configuration
# Copy this file to .env and fill in your credentials.
# NEVER commit the .env file to version control.
# ============================================================

# ── Exchange credentials ─────────────────────────────────────
EXCHANGE_NAME=binance
EXCHANGE_API_KEY=your_api_key_here
EXCHANGE_API_SECRET=your_api_secret_here
# Set to true for testnet/paper trading (strongly recommended to start)
EXCHANGE_SANDBOX=true

# ── Telegram notifications ──────────────────────────────────
# Create a bot at @BotFather, get the chat_id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── REST API security ───────────────────────────────────────
# Random secret key for the FastAPI control endpoint
API_KEY=change_me_to_a_random_string_32_chars

# ── TradingView webhook ────────────────────────────────────
# Must match the secret in your TradingView alert URL
WEBHOOK_SECRET=change_me_to_another_random_string

# ── AI Trading Advisor (Polymarket + WSB + Claude) ─────────
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ── Active strategy ────────────────────────────────────────
# Options: trend_ema, mean_reversion, breakout, supertrend,
#          vwap_bounce, ichimoku, mtf, hybrid_ml,
#          regime_adaptive, ensemble, grid_trading, dca,
#          macd_divergence, heikin_ashi, volume_profile
ACTIVE_STRATEGY=regime_adaptive

# ── Trading pairs (comma-separated) ───────────────────────
TRADING_PAIRS=BTC/USDT,ETH/USDT,BNB/USDT,SOL/USDT

# ── Risk settings (override config.yaml) ──────────────────
STAKE_AMOUNT_PCT=0.02
MAX_OPEN_TRADES=5
MAX_DRAWDOWN_PCT=0.15

# ── Dry run mode ───────────────────────────────────────────
# true = paper trading (no real orders placed)
DRY_RUN=true

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO
